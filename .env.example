# Porta e URL pública do app (usada no redirect do OAuth)
PORT=3000
BASE_URL=http://localhost:3000

# App do Discord: https://discord.com/developers/applications
# Em OAuth2 > Redirects, cadastre: <BASE_URL>/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Qualquer texto longo e aleatório
SESSION_SECRET=

# Opcional: servidor TURN para quem está atrás de NAT restritivo
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Sem DISCORD_CLIENT_ID, o app entra em modo de desenvolvimento:
# o login pede só um nome e não verifica o servidor do Discord.
